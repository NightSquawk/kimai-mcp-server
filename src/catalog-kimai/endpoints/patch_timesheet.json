{
  "operationId": "patch_timesheet",
  "resource": "timesheets",
  "category": "Timesheet",
  "name": "Update timesheet",
  "method": "PATCH",
  "path": "/api/timesheets/{id}",
  "description": "Update timesheet, you can pass all or just a subset of the attributes.",
  "writeOperation": true,
  "destructive": false,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "id",
      "type": "string",
      "required": true,
      "in": "path",
      "description": "Timesheet ID to update",
      "pattern": "\\d+"
    }
  ],
  "params": [],
  "bodySchema": {
    "type": "object",
    "properties": {
      "activity": {
        "type": "integer",
        "description": "Activity ID"
      },
      "begin": {
        "type": "string",
        "format": "date-time",
        "description": "If no begin date-time is set, the users current timestamp will be used"
      },
      "billable": {
        "type": "boolean"
      },
      "description": {
        "type": "string"
      },
      "end": {
        "type": "string",
        "format": "date-time",
        "description": "If no end date-time is set, the timesheet will be running"
      },
      "exported": {
        "type": "boolean"
      },
      "fixedRate": {
        "type": "number",
        "description": "Fixed rate"
      },
      "hourlyRate": {
        "type": "number",
        "description": "Hourly rate"
      },
      "project": {
        "type": "integer",
        "description": "Project ID"
      },
      "tags": {
        "type": "string",
        "description": "Comma separated list of tags"
      },
      "user": {
        "type": "integer",
        "description": "User ID"
      }
    },
    "required": [
      "project",
      "activity"
    ]
  },
  "bodyContentType": "application/json",
  "responses": {
    "200": {
      "description": "Returns the updated timesheet"
    }
  },
  "requestSample": "curl -X PATCH '$KIMAI_BASE_URL/api/timesheets/{id}' -H 'Authorization: Bearer $KIMAI_API_TOKEN' -H 'Content-Type: application/json' -d '{...}'"
}
