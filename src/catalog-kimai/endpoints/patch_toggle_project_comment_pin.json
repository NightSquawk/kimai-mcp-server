{
  "operationId": "patch_toggle_project_comment_pin",
  "resource": "projects",
  "category": "Project",
  "name": "Pin project comment",
  "method": "PATCH",
  "path": "/api/projects/{id}/comments/{comment}/pin",
  "description": "This toggles the `pinned` status of the given comment.",
  "writeOperation": true,
  "destructive": false,
  "paramLocation": "query",
  "pathParams": [
    {
      "name": "id",
      "type": "string",
