{
  "operationId": "patch_app_api_customer_meta",
  "resource": "customers",
  "category": "Customer",
  "name": "Update customer custom-field",
  "method": "PATCH",
  "path": "/api/customers/{id}/meta",
  "description": "Update customer custom-field",
  "writeOperation": true,
  "destructive": false,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "id",
      "type": "string",
      "required": true,
      "in": "path",
      "description": "Customer record ID to set the meta-field value for",
      "pattern": "\\d+"
    }
  ],
  "params": [],
  "bodySchema": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string"
      },
      "value": {
        "type": "string"
      }
    },
    "required": [
      "name",
      "value"
    ]
  },
  "bodyContentType": "application/json",
  "responses": {
    "200": {
      "description": "Sets the value of an existing/configured meta-field. You cannot create unknown meta-fields, if the given name is not a configured meta-field, this will return an exception."
    }
  },
  "requestSample": "curl -X PATCH '$KIMAI_BASE_URL/api/customers/{id}/meta' -H 'Authorization: Bearer $KIMAI_API_TOKEN' -H 'Content-Type: application/json' -d '{...}'"
}
