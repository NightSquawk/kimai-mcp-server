{
  "operationId": "get_tasks",
  "resource": "tasks",
  "category": "Task",
  "name": "List tasks",
  "method": "GET",
  "path": "/api/tasks",
  "description": "Returns a collection of tasks. Requires the Kimai Task Management plugin. HAND-AUTHORED: see get_expenses for what that means about parameter fidelity.",
  "writeOperation": false,
  "destructive": false,
  "paramLocation": "query",
  "pathParams": [],
  "params": [
    {
      "name": "page",
      "type": "string",
      "required": false,
      "in": "query",
      "description": "Page number, 1-based.",
      "default": "1"
    },
    {
      "name": "size",
      "type": "string",
      "required": false,
      "in": "query",
      "description": "Entries per page.",
      "default": "50"
    }
  ],
  "bodySchema": null,
  "bodyContentType": null,
  "responses": {
    "200": {
      "description": "Returns a collection of task entities"
    },
    "404": {
      "description": "Task Management plugin is not installed on this instance"
    }
  },
  "requestSample": "curl -X GET '$KIMAI_BASE_URL/api/tasks' -H 'Authorization: Bearer $KIMAI_API_TOKEN'",
  "pluginOnly": true
}
