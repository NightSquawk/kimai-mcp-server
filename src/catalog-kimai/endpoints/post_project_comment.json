{
  "operationId": "post_project_comment",
  "resource": "projects",
  "category": "Project",
  "name": "Add comment for project",
  "method": "POST",
  "path": "/api/projects/{id}/comments",
  "description": "Add comment for project",
  "writeOperation": true,
  "destructive": false,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "id",
      "type": "string",
      "required": true,
      "in": "path",
      "description": "The project to add the comment for",
      "pattern": "\\d+"
    }
  ],
  "params": [],
  "bodySchema": {
    "type": "object",
    "properties": {
      "message": {
        "type": "string",
        "description": "The actual comment (markdown is supported)"
      },
      "pinned": {
        "type": "boolean",
        "description": "Pinned comments always appear first"
      }
    },
    "required": [
      "message"
    ]
  },
  "bodyContentType": "application/json",
  "responses": {
    "200": {
      "description": "Returns the newly created project comment"
    }
  },
  "requestSample": "curl -X POST '$KIMAI_BASE_URL/api/projects/{id}/comments' -H 'Authorization: Bearer $KIMAI_API_TOKEN' -H 'Content-Type: application/json' -d '{...}'"
}
