  "destructive": false,
  "paramLocation": "query",
  "pathParams": [
    {
      "name": "id",
      "type": "string",
      "required": true,
      "in": "path",
      "description": "Timesheet ID to fetch",
      "pattern": "\\d+"
    }
  ],
  "params": [],
  "bodySchema": null,
  "bodyContentType": null,
  "responses": {
