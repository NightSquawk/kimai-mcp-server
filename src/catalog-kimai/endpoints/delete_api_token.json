{
  "operationId": "delete_api_token",
  "resource": "users",
  "category": "User",
  "name": "Delete API token",
  "method": "DELETE",
  "path": "/api/users/api-token/{id}",
  "description": "This ONLY works if the given API token exists and belongs to the current user",
  "writeOperation": true,
  "destructive": true,
  "paramLocation": "query",
  "pathParams": [
    {
      "name": "id",
      "type": "string",
      "required": true,
      "in": "path",
      "description": "The API token ID to remove",
      "pattern": "\\d+"
    }
  ],
  "params": [],
  "bodySchema": null,
  "bodyContentType": null,
  "responses": {
    "200": {
      "description": "Success if the token could be deleted."
    }
  },
  "requestSample": "curl -X DELETE '$KIMAI_BASE_URL/api/users/api-token/{id}' -H 'Authorization: Bearer $KIMAI_API_TOKEN'"
}
