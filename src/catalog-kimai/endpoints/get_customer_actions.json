{
  "operationId": "get_customer_actions",
  "resource": "actions",
  "category": "Actions",
  "name": "Fetch item actions for Customer",
  "method": "GET",
  "path": "/api/actions/customer/{id}/{view}/{locale}",
  "description": "Fetch item actions for Customer",
  "writeOperation": false,
  "destructive": false,
  "paramLocation": "query",
  "pathParams": [
    {
      "name": "id",
      "type": "string",
      "required": true,
      "in": "path",
      "description": "Customer ID to fetch",
      "pattern": "\\d+"
    },
    {
      "name": "view",
      "type": "string",
      "required": true,
      "in": "path",
      "description": "View to display the actions at (e.g. index, custom)"
    },
    {
      "name": "locale",
      "type": "string",
      "required": true,
      "in": "path",
      "description": "Language to translate the action title to (e.g. de, en)"
    }
  ],
  "params": [],
  "bodySchema": null,
  "bodyContentType": null,
  "responses": {
    "200": {
      "description": "Returns item actions for the customer"
    }
  },
  "requestSample": "curl -X GET '$KIMAI_BASE_URL/api/actions/customer/{id}/{view}/{locale}' -H 'Authorization: Bearer $KIMAI_API_TOKEN'"
}
