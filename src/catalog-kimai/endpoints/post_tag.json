{
  "operationId": "post_tag",
  "resource": "tags",
  "category": "Tag",
  "name": "Create tag",
  "method": "POST",
  "path": "/api/tags",
  "description": "Creates a new tag and returns it afterwards",
  "writeOperation": true,
  "destructive": false,
  "paramLocation": "body",
  "pathParams": [],
  "params": [],
  "bodySchema": {
    "type": "object",
    "properties": {
      "color": {
        "type": "string",
        "description": "The hexadecimal color code (default: auto-calculated by name)"
      },
      "name": {
        "type": "string",
        "description": "The tag name (forbidden character: comma)"
      },
      "visible": {
        "type": "boolean"
      }
    },
    "required": [
      "name"
    ]
  },
  "bodyContentType": "application/json",
  "responses": {
    "200": {
      "description": "Returns the new created tag"
    }
  },
  "requestSample": "curl -X POST '$KIMAI_BASE_URL/api/tags' -H 'Authorization: Bearer $KIMAI_API_TOKEN' -H 'Content-Type: application/json' -d '{...}'"
}
