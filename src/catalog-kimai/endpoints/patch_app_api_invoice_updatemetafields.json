{
  "operationId": "patch_app_api_invoice_updatemetafields",
  "resource": "invoices",
  "category": "Invoice",
  "name": "Update invoice custom-fields",
  "method": "PATCH",
  "path": "/api/invoices/{id}/custom-fields",
  "description": "Update invoice custom-fields",
  "writeOperation": true,
  "destructive": false,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "id",
      "type": "string",
      "required": true,
      "in": "path",
      "description": "Invoice ID to set the custom-fields for",
      "pattern": "\\d+"
    }
  ],
  "params": [],
  "bodySchema": {
    "type": "array",
    "items": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ]
    }
  },
  "bodyContentType": "application/json",
  "responses": {
    "200": {
      "description": "Sets the value of configured custom-fields. You cannot create unknown custom-fields."
    }
  },
  "requestSample": "curl -X PATCH '$KIMAI_BASE_URL/api/invoices/{id}/custom-fields' -H 'Authorization: Bearer $KIMAI_API_TOKEN' -H 'Content-Type: application/json' -d '{...}'"
}
